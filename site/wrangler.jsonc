{
  // openfitnessprotocol.org (and .com, www. on both, redirected to it). Deploy: site/deploy.sh (account and credentials come from the environment).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ofp-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "ofp-releases" },
    // recordings people send from OFP Studio: private, never served, deleted after 90 days (bucket rule)
    { "binding": "SUBMISSIONS", "bucket_name": "ofp-submissions" }
  ],
  // two submissions a minute from one address (the period can only be 10 or 60 s)
  "ratelimits": [{ "name": "SUBMIT_LIMIT", "namespace_id": "4747", "simple": { "limit": 2, "period": 60 } }],
  "routes": [
    { "pattern": "openfitnessprotocol.com", "custom_domain": true },
    { "pattern": "www.openfitnessprotocol.com", "custom_domain": true },
    { "pattern": "openfitnessprotocol.org", "custom_domain": true },
    { "pattern": "www.openfitnessprotocol.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
