{
  "name": "@openfitnessprotocol/ofp",
  "version": "0.2.3",
  "description": "Open Fitness Protocol: read fitness devices (heart rate, power, FTMS bikes, rowers, treadmills and more) from any JavaScript app. The core (WebAssembly, or plain JavaScript for React Native), the device tables, and the four hooks an app wires up.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "LICENSE",
    "NOTICE",
    "adapters",
    "core",
    "index.d.ts",
    "index.js",
    "registry.bundle.json",
    "registry.d.ts",
    "registry.js"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./adapters/noble": "./adapters/noble.js",
    "./adapters/react-native-ble-manager": "./adapters/react-native-ble-manager.js",
    "./core/ofp_core.wasm": "./core/ofp_core.wasm",
    "./core/js": {
      "types": "./core/ofp_core.asm.d.ts",
      "default": "./core/ofp_core.asm.js"
    },
    "./registry": {
      "types": "./registry.d.ts",
      "default": "./registry.js"
    },
    "./registry.bundle.json": "./registry.bundle.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/ofp.test.js"
  },
  "homepage": "https://openfitnessprotocol.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trainerday/openfitnessprotocol.git",
    "directory": "packages/ofp-js"
  },
  "bugs": {
    "url": "https://github.com/trainerday/openfitnessprotocol/issues"
  },
  "keywords": [
    "bluetooth",
    "ble",
    "fitness",
    "ftms",
    "heart-rate",
    "cycling",
    "power-meter",
    "indoor-bike",
    "rower",
    "react-native",
    "electron"
  ],
  "publishConfig": {
    "access": "public"
  }
}
